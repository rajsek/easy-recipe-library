# Copy to .env and fill in. .env is gitignored - never commit real values.

# 'demo'  = bundled demo data, no Google account needed, writes stay in memory.
# 'sheets'= your private Google Sheet (setup in README).
DATA_MODE=demo

# --- sheets mode only ---
# The ID from your Sheet's URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
SHEET_ID=
# Service account key JSON on ONE line (README shows how to create it).
# The Sheet must be shared with the service account's email as Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternative: path to the downloaded key file instead of pasting JSON.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# --- AI ranking (OFF by default) ---
# Leave both empty to keep AI off: picks are then deterministic and unranked.
# Free-tier Gemini API keys allow Google to train on submitted data and have it
# human-reviewed (ai.google.dev/gemini-api/terms). Paid-tier data is not used
# for training. Only set these after you have chosen knowingly.
AI_PROVIDER=
GEMINI_API_KEY=

# --- server ---
PORT=3000
# Bind address. Default 127.0.0.1 = reachable only from this computer.
# Only change this for deployment, and then APP_TOKEN is REQUIRED:
# the server refuses to start on a non-local interface without it.
HOST=127.0.0.1
# Shared secret that protects every /api route when the app is reachable
# from a network. Generate one: openssl rand -hex 24
APP_TOKEN=
