{
  "name": "easy-recipe-library",
  "version": "0.1.0",
  "private": true,
  "description": "Non-repeating easy meal picker over a private Google Sheet recipe library. Local-runnable, deployable with .env config.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite web",
    "build": "vite build web",
    "start": "tsx server/index.ts",
    "test": "node --import tsx --test server/*.test.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "googleapis": "^150.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
